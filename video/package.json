{
  "name": "hero-swap-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion animated walkthrough of the Hero Swap chain, bundled for the browser Player.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/embed.tsx --bundle --minify --format=iife --outfile=../assets/swap-video.bundle.js --define:process.env.NODE_ENV='\"production\"'",
    "studio": "remotion studio"
  },
  "dependencies": {
    "@remotion/player": "4.0.498",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.498"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.498",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
